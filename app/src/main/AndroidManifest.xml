<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 2026-09-15: 자동참여가 매번 "파트너스 앱을 찾을 수 없음"으로 실패한 진짜 원인.
         패키지명(com.classy.ganpoompartner)은 실제로 맞았지만, Android 11+(targetSdk 30 이상)의
         패키지 가시성 제한 때문에 <queries>로 명시 선언하지 않으면 실제로 설치돼 있어도
         PackageManager.getLaunchIntentForPackage()가 조용히 null을 반환한다(설치 여부와 무관하게
         "안 보이는" 상태) - 드라이런/실클릭, 대기시간과 무관하게 매번 같은 지점에서 실패했던 이유. -->
    <queries>
        <package android:name="com.classy.ganpoompartner" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 2026-09-15: 자동참여 흐름 중 화면이 꺼져있어도 CPU가 잠들지 않게 유지(Doze로 인한
         폴링 지연/무한대기 방지) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 2026-09-16: 인앱 자동 업데이트 - 다운로드한 APK를 앱이 직접 설치 확인창까지 띄우려면
         필요(Android 8+). 최초 1회는 사용자가 명시적으로 허용해야 하며(정책상 우회 불가),
         UpdateChecker.canInstallPackages()로 확인 후 없으면 권한 설정 화면으로 안내한다. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KakaoAlertBridge">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.KakaoAlertBridge"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2026-09-15: 자동참여 시작 시 화면을 깨우고(잠금화면이 없거나 밀어서 잠금해제인
             경우) 잠금을 넘긴 뒤 파트너스 앱을 실행하기 위한 투명 액티비티. 접근성 서비스는
             자체 윈도우가 없어 이 두 가지(화면 켜기/잠금 넘기기)를 직접 할 수 없다. -->
        <activity
            android:name=".WakeAndLaunchActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".KakaoNotificationListenerService"
            android:label="MG애드 콜 알림 감지"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="카카오톡 콜 알림 감지 브릿지 - 새 견적 요청 알림을 놓치지 않기 위해 지속 실행" />
        </service>

        <!-- 하트비트 이중 안전장치: 서버의 무음 웨이크 핑을 받아 즉시 하트비트를 재전송 -->
        <service
            android:name=".FcmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 업무시간 외 "상담참여" 자동확보 - 파트너스 앱 UI 조작용 접근성 서비스.
             기본값은 꺼짐(AutoParticipateSettings) - 사용자가 설정 화면에서 명시적으로 켜야 함. -->
        <service
            android:name=".PartnersAutoParticipateService"
            android:label="MG애드 야간 상담참여 자동확보"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_participate_accessibility_config" />
        </service>

        <!-- 2026-09-16: 인앱 자동 업데이트가 다운로드한 APK 파일(앱 전용 외부 저장소)을
             시스템 설치 프로그램에게 content:// URI로 넘겨주기 위함(file:// URI 직접 노출은
             Android 7+에서 FileUriExposedException으로 막혀있음). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>